// Force-creates or updates the admin account to match the CURRENT
// ADMIN_EMAIL / ADMIN_PASSWORD in .env — use this if login says
// "Invalid credentials" after you changed .env values post-seed
// (the normal seed script only creates the admin if none exists yet,
// it never overwrites an existing one).
require('dotenv').config()
const mongoose = require('mongoose')
const bcrypt = require('bcryptjs')
const connectDB = require('../config/db')
const Admin = require('../models/Admin')

async function run() {
  await connectDB()

  const email = (process.env.ADMIN_EMAIL || 'admin@lextrust.com').toLowerCase().trim()
  const password = process.env.ADMIN_PASSWORD || 'ChangeMe123!'
  const hashed = await bcrypt.hash(password, 10)

  const admin = await Admin.findOneAndUpdate(
    { email },
    { name: 'Admin', email, password: hashed },
    { upsert: true, new: true, setDefaultsOnInsert: true }
  )

  console.log(`\n✅ Admin is now set to:`)
  console.log(`   email:    ${admin.email}`)
  console.log(`   password: ${password}  (as currently set in .env)\n`)

  await mongoose.connection.close()
  process.exit(0)
}

run().catch((err) => {
  console.error('❌ Reset failed:', err.message)
  process.exit(1)
})