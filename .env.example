# ============================================
# LexTrust Backend - Environment Variables
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to GitHub.
# ============================================

# Server
PORT=5000
NODE_ENV=development

# ---- MongoDB Atlas ----
# Get this from Atlas -> Database -> Connect -> Drivers -> Node.js
# Replace <username>, <password>, <cluster-url> and add your db name at the end.
# Example: mongodb+srv://lextrust_admin:YourPassword123@cluster0.abcde.mongodb.net/lextrust?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/lextrust?retryWrites=true&w=majority

# Database / collection naming (used by models, change if you want different names)
DB_NAME=lextrust
COLLECTION_LEADS=leads
COLLECTION_SUBSCRIBERS=subscribers
COLLECTION_PRACTICE_AREAS=practiceareas
COLLECTION_LAWYERS=lawyers
COLLECTION_TESTIMONIALS=testimonials
COLLECTION_SITE_CONTENT=sitecontents
COLLECTION_SETTINGS=settings
COLLECTION_ADMINS=admins

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# First admin user auto-created by the seed script (change password after first login!)
ADMIN_EMAIL=admin@lextrust.com
ADMIN_PASSWORD=ChangeMe123!

# ---- CORS ----
# Comma separated list of frontend origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# ---- Email (optional - for admin notification + newsletter welcome email) ----
# Works with Gmail (use an "App Password", not your real Gmail password) or any SMTP provider
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ADMIN_NOTIFY_EMAIL=admin@lextrust.com
EMAIL_FROM="LexTrust <no-reply@lextrust.com>"
